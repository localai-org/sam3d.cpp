+// CPY counts its own src[1] reference. Only elide a fresh cast whose sole
+// other use is the widening cast; keep requested outputs and strided cases.
+static bool ggml_vk_can_fuse_bf16_round(const ggml_cgraph * graph, int i) {
+    if (getenv("GGML_VK_FUSE_BF16_ROUND") == nullptr || i + 1 >= graph->n_nodes) return false;
+    const auto * narrow = graph->nodes[i];
+    const auto * wide = graph->nodes[i + 1];
+    return narrow->op == GGML_OP_CPY && wide->op == GGML_OP_CPY &&
+        narrow->src[0] && narrow->src[0]->type == GGML_TYPE_F32 &&
+        narrow->type == GGML_TYPE_BF16 && wide->type == GGML_TYPE_F32 &&
+        narrow->src[1] == narrow && wide->src[1] == wide && wide->src[0] == narrow &&
+        !narrow->view_src && !wide->view_src &&
+        (narrow->flags & GGML_TENSOR_FLAG_COMPUTE) && (wide->flags & GGML_TENSOR_FLAG_COMPUTE) &&
+        !(narrow->flags & GGML_TENSOR_FLAG_OUTPUT) && ggml_node_get_use_count(graph, i) == 2 &&
+        ggml_are_same_shape(narrow, wide) && ggml_are_same_shape(narrow, narrow->src[0]) &&
+        ggml_is_contiguous(narrow->src[0]) && ggml_is_contiguous(narrow) && ggml_is_contiguous(wide);
+}
