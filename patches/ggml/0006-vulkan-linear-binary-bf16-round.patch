diff --git a/src/ggml-vulkan/vulkan-shaders/binary_round_bf16.comp b/src/ggml-vulkan/vulkan-shaders/binary_round_bf16.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/binary_round_bf16.comp
@@ -0,0 +1,35 @@
+#version 450
+// Adapted from GGML's add.comp/mul.comp (MIT). Only indexing changes:
+// preserve the separate F32 operation and exact RNE BF16 round trip.
+#include "types.glsl"
+#include "generic_binary_head.glsl"
+#if !BINARY_MUL
+layout (binding = 3, std430) buffer PartialBuf {float partial_sums[];};
+#endif
+// 0: same shape; 1: one row repeated; 2: scalar repeated.
+layout(constant_id = 1) const uint repeat_mode = 0;
+const uint num_threads = 256;
+layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;
+void main() {
+    uint idx = get_idx();
+    // Must match the backend's 512-element workgroup decomposition.
+    [[unroll]] for (uint i = 0; i < 2; ++i) {
+        if (idx < p.ne) {
+            uint b = repeat_mode == 0 ? idx : repeat_mode == 1 ? fastmod(idx, p.ne10) : 0;
+            float a_value = data_a[get_aoffset() + idx];
+            float b_value = data_b[get_boffset() + b];
+#if BINARY_MUL
+            precise float value = a_value * b_value;
+#else
+            precise float value = a_value + b_value;
+#endif
+            data_d[get_doffset() + idx] = bf16_to_fp32(fp32_to_bf16(value));
+        }
+        idx += num_threads;
+    }
+}
