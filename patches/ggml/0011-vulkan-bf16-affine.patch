+    const auto * add=graph->nodes[ai];
+    const auto * previous=graph->nodes[ai-1];
+    if(add->op!=GGML_OP_ADD || !ggml_vk_can_fuse_binary_bf16_round(graph,ai) ||
+       (add->src[0]!=previous && add->src[1]!=previous) || !ggml_are_same_shape(add,mul)) return 0;
+    const auto * bias=add->src[add->src[0]==previous?1:0];
+    const auto * dst=graph->nodes[ai+2];
+    if(bias==previous || !ggml_vk_affine_operand(bias,mul) ||
+       ggml_nelements(dst)>UINT32_MAX || !dst->buffer || ggml_backend_buffer_is_host(dst->buffer)) return 0;
+    // Check real inputs including leaf tensors; exact same-size alias is safe,
+    // but partial overlap or a broadcast input overwritten by output is not.
