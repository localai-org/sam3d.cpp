+        if(!repeating && a->ne[d]==full->ne[d]) continue;
+        if(a->ne[d]!=1) return false;
+        repeating=true;
+    }
+    return true;
+}
+static int ggml_vk_affine_bf16_length(const ggml_cgraph * graph,int i) {
+    const char * enabled=getenv("GGML_VK_FUSE_BF16_AFFINE");
+    if(!enabled || strcmp(enabled,"1")!=0 || i+3>=graph->n_nodes) return 0;
+    const auto * mul=graph->nodes[i];
