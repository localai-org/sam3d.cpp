+static void ggml_vk_affine_bf16(ggml_backend_vk_context * ctx, vk_context & subctx,
+                              ggml_cgraph * graph, int i) {
+    const int add_index=i+(ctx->num_additional_fused_ops==5?3:1);
+    const auto * mul=graph->nodes[i];
+    const auto * add=graph->nodes[add_index];
+    const auto * previous=graph->nodes[add_index-1];
+    const auto * bias=add->src[add->src[0]==previous?1:0];
+    const auto * dst=graph->nodes[i+ctx->num_additional_fused_ops];
+    const auto * a=mul->src[0]; const auto * b=mul->src[1];
+    vk_affine_bf16_push_constants pc{
+        (uint32_t)ggml_nelements(dst),(uint32_t)ggml_nelements(b),(uint32_t)ggml_nelements(bias),
+        ctx->num_additional_fused_ops==5?1u:0u,
+        get_misalign_bytes(ctx,a)/4,get_misalign_bytes(ctx,b)/4,
+        get_misalign_bytes(ctx,bias)/4,get_misalign_bytes(ctx,dst)/4};
+    auto pipeline=ctx->device->pipeline_affine_bf16;
+    ggml_pipeline_request_descriptor_sets(ctx,pipeline,1);
+    std::array<uint32_t,3> elements=pc.ne>262144?std::array<uint32_t,3>{512,512,CEIL_DIV(pc.ne,262144)}:
+        pc.ne>512?std::array<uint32_t,3>{512,CEIL_DIV(pc.ne,512),1}:std::array<uint32_t,3>{pc.ne,1,1};
+    ggml_vk_dispatch_pipeline(ctx,subctx,pipeline,{
+        ggml_vk_tensor_subbuffer(ctx,a,true),ggml_vk_tensor_subbuffer(ctx,b,true),
+        ggml_vk_tensor_subbuffer(ctx,bias,true),ggml_vk_tensor_subbuffer(ctx,dst,true)},pc,elements);
+}
