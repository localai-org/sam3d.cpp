@@ -0,0 +1,24 @@
+#version 450
+// GGML-derived indexing and RNE BF16 conversion; keep separate F32 operations.
+#include "types.glsl"
+#include "utils.glsl"
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+layout(push_constant) uniform parameter {
+    uint ne; uint nb; uint nc; uint round_mul;
+    uint ao; uint bo; uint co; uint dst;
+} p;
+layout(binding=0) readonly buffer A { float a[]; };
+layout(binding=1) readonly buffer B { float b[]; };
+layout(binding=2) readonly buffer C { float c[]; };
+layout(binding=3) writeonly buffer D { float d[]; };
+void main() {
+    uint idx=gl_GlobalInvocationID.z*262144+gl_GlobalInvocationID.y*512+gl_GlobalInvocationID.x;
+    for(uint k=0;k<2;++k,idx+=256) if(idx<p.ne) {
+        uint bi=p.nb==p.ne?idx:fastmod(idx,p.nb);
+        uint ci=p.nc==p.ne?idx:fastmod(idx,p.nc);
+        precise float product=a[p.ao+idx]*b[p.bo+bi];
+        float rounded=p.round_mul!=0?bf16_to_fp32(fp32_to_bf16(product)):product;
+        precise float value=rounded+c[p.co+ci];
+        d[p.dst+idx]=bf16_to_fp32(fp32_to_bf16(value));
+    }
+}
