+       !(mul->flags&GGML_TENSOR_FLAG_COMPUTE) || (mul->flags&GGML_TENSOR_FLAG_OUTPUT) ||
+       ggml_node_get_use_count(graph,i)!=1 || !ggml_is_contiguous(mul) ||
+       !mul->src[0] || !ggml_are_same_shape(mul,mul->src[0]) ||
+       !ggml_vk_affine_operand(mul->src[0],mul) || !ggml_vk_affine_operand(mul->src[1],mul)) return 0;
+    int ai=i+1;
