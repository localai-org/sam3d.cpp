+static bool ggml_vk_tensors_overlap(const ggml_tensor * a, const ggml_tensor * b, bool elementwise);
+// A dense leading block may repeat; reject column/interior-dimension broadcasts.
+static bool ggml_vk_affine_operand(const ggml_tensor * a,const ggml_tensor * full) {
+    if (!a || a->type!=GGML_TYPE_F32 || !ggml_is_contiguous(a)) return false;
+    bool repeating=false;
