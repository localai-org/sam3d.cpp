+// Narrow capability handshake: ordinary F32 MUL_MAT keeps F32 operands with
+// CM2 enabled. It makes no promise about MUL_MAT_ID or a CM1 fallback.
+static bool ggml_backend_vk_f32_matmul_cm2_v1(ggml_backend_t backend) {
+    auto *ctx = static_cast<ggml_backend_vk_context *>(backend->context);
+    return ctx->device->coopmat2 && ctx->device->coopmat2_bf16_support;
+}
+static void * ggml_backend_vk_reg_get_proc_address(ggml_backend_reg_t reg, const char *name) {
+    GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_vk_f32_matmul_cm2_v1") == 0) {
+        return reinterpret_cast<void *>(ggml_backend_vk_f32_matmul_cm2_v1);
+    }
+    return nullptr;
+}
