diff --git a/src/ggml-vulkan/ggml-vulkan.cpp b/src/ggml-vulkan/ggml-vulkan.cpp
--- a/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4692,4 +4692,6 @@
                           std::array<uint32_t, 3> wg, std::vector<uint32_t> spec,
-                          bool aligned, uint32_t align) {
+                          bool aligned, uint32_t align, uint32_t f32_bk = 32) {
             spec.push_back(aligned ? 1u : 0u);
+            spec.resize(14, 0);
+            spec.push_back(f32_bk);
             ggml_vk_create_pipeline(device, slot, name, matmul_f32_f32_fp32_len,
@@ -4713,4 +4713,16 @@
         if (device->vendor_id == VK_VENDOR_ID_NVIDIA && device->subgroup_size == 32) {
+            const char * tile = getenv("GGML_VK_F32_NARROW_TILE");
+            if (tile && strcmp(tile, "deep64") == 0) {
+                scalar(device->pipeline_matmul_f32_narrow,"matmul_f32_f32_narrow_deep64",{16,8,1},
+                    {32,16,8,16,16,8,1,2,2,1,32},false,1,64);
+            } else if (tile && strcmp(tile, "tiny32") == 0) {
+                scalar(device->pipeline_matmul_f32_narrow,"matmul_f32_f32_narrow_tiny32",{8,8,1},
+                    {32,8,8,16,8,8,1,2,1,1,32},false,1);
+            } else if (tile && strcmp(tile, "tiny64") == 0) {
+                scalar(device->pipeline_matmul_f32_narrow,"matmul_f32_f32_narrow_tiny64",{8,8,1},
+                    {32,8,8,16,8,8,1,2,1,1,32},false,1,64);
+            } else {
             scalar(device->pipeline_matmul_f32_narrow,"matmul_f32_f32_narrow",{16,8,1},
                 {32,16,8,16,16,8,1,2,2,1,32},false,1);
+            }
         }
