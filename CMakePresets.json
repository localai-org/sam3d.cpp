{
  "version": 5,
  "configurePresets": [
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "SAM3D_SANITIZERS": "ON", "BUILD_TESTING": "ON"}},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/build/release",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "SAM3D_SANITIZERS": "OFF"}},
    {"name": "optimized-sanitizers", "inherits": "debug", "binaryDir": "${sourceDir}/build/optimized-sanitizers",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g", "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g", "SAM3D_SANITIZERS": "ON", "SAM3D_ADDRESS_SANITIZER": "ON", "SAM3D_VULKAN": "OFF"}},
    {"name": "vulkan-ubsan", "inherits": "debug", "binaryDir": "${sourceDir}/build/vulkan-ubsan",
     "cacheVariables": {"SAM3D_VULKAN": "ON", "SAM3D_ADDRESS_SANITIZER": "OFF"}},
    {"name": "vulkan-optimized", "inherits": "optimized-sanitizers", "binaryDir": "${sourceDir}/build/vulkan-optimized",
     "cacheVariables": {"SAM3D_VULKAN": "ON", "SAM3D_ADDRESS_SANITIZER": "OFF"}},
    {"name": "vulkan-bf16-cm2", "inherits": "vulkan-optimized", "binaryDir": "${sourceDir}/build/vulkan-bf16-cm2",
     "cacheVariables": {"SAM3D_EXPERIMENTAL_GGML_PATCHES": "ON"}},
    {"name": "vulkan-bf16-production", "inherits": "vulkan-bf16-cm2", "binaryDir": "${sourceDir}/build/vulkan-bf16-performance",
     "cacheVariables": {"SAM3D_SANITIZERS": "OFF", "SAM3D_ADDRESS_SANITIZER": "OFF", "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -g0", "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g0"}},
    {"name": "fuzz", "inherits": "debug", "binaryDir": "${sourceDir}/build/fuzz",
     "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "SAM3D_FUZZ": "ON", "BUILD_TESTING": "OFF"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "optimized-sanitizers", "configurePreset": "optimized-sanitizers"},
    {"name": "vulkan-ubsan", "configurePreset": "vulkan-ubsan"},
    {"name": "vulkan-optimized", "configurePreset": "vulkan-optimized"},
    {"name": "vulkan-bf16-cm2", "configurePreset": "vulkan-bf16-cm2"},
    {"name": "vulkan-bf16-production", "configurePreset": "vulkan-bf16-production"},
    {"name": "fuzz", "configurePreset": "fuzz"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "vulkan-optimized", "configurePreset": "vulkan-optimized", "output": {"outputOnFailure": true}},
    {"name": "vulkan-bf16-cm2", "configurePreset": "vulkan-bf16-cm2", "output": {"outputOnFailure": true}},
    {"name": "optimized-sanitizers", "configurePreset": "optimized-sanitizers", "output": {"outputOnFailure": true}}
  ]
}
